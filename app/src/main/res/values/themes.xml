<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChargeFloat" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/onBrand</item>
        <item name="colorPrimaryContainer">#3A1A14</item>
        <item name="colorOnPrimaryContainer">#FFD9D0</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorSurfaceVariant">@color/surfaceHigh</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="SectionValue">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>
</resources>
